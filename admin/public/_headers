# The admin panel is an internal operations desk and must never be indexed.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Alt-Svc: h3=":443"; ma=86400
  Cache-Control: no-cache, no-store, must-revalidate

# Root admin shell
/
  Cache-Control: no-cache, no-store, must-revalidate

# Vite emits content-hashed asset filenames, so they are safe to cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Timing-Allow-Origin: *

# The shell must always be revalidated so operators pick up new releases.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
