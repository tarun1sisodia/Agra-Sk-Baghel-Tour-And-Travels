{
  "info": {
    "name": "SK Baghel Tour & Travels — Fare System & Monorepo Test Suite",
    "_postman_id": "skb-fare-system-suite-2026",
    "description": "Complete Postman Collection for Admin CRUD across product categories and vehicle groups, plus customer reactive options, authoritative quotes, concurrency 409 guards, and booking creation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "test-super_admin",
      "type": "string"
    },
    {
      "key": "routeId",
      "value": "20000000-0000-0000-0001-000000000001",
      "type": "string"
    },
    {
      "key": "sedanModelId",
      "value": "10000000-0000-0000-0002-000000000001",
      "type": "string"
    },
    {
      "key": "innovaModelId",
      "value": "10000000-0000-0000-0002-000000000004",
      "type": "string"
    },
    {
      "key": "lastBookingId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Server Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Verifies that the backend Fastify server is running and healthy."
      }
    },
    {
      "name": "02. Admin — Fleet & Vehicle Groups",
      "item": [
        {
          "name": "2.1 List All Vehicle Groups",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/fares/vehicle-groups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "fares", "vehicle-groups"]
            },
            "description": "Returns the 4 vehicle groups (sedan, suv, luxury, tempo_traveller) with their driver allowances and night charges."
          }
        },
        {
          "name": "2.2 Update Sedan Driver Allowance & Night Charges",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driver_allowance_per_day\": 550,\n  \"one_way_night_charge\": 250,\n  \"round_trip_halt_per_night\": 300\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/fares/vehicle-groups/10000000-0000-0000-0001-000000000001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "fares", "vehicle-groups", "10000000-0000-0000-0001-000000000001"]
            },
            "description": "Updates driver allowance and night charges for Sedan group. Writes before/after to admin_audit_logs."
          }
        },
        {
          "name": "2.3 Create New Vehicle Model (e.g. Maruti Ciaz)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_group_id\": \"10000000-0000-0000-0001-000000000001\",\n  \"make\": \"Maruti\",\n  \"model_name\": \"Ciaz\",\n  \"display_name\": \"Maruti Ciaz (Executive Sedan)\",\n  \"passenger_capacity\": 4,\n  \"luggage_capacity\": 3,\n  \"sort_order\": 15,\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/fares/vehicle-models",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "fares", "vehicle-models"]
            },
            "description": "Creates a new vehicle model under Sedan group."
          }
        },
        {
          "name": "2.4 Update Vehicle Model Capacity / Active Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passenger_capacity\": 4,\n  \"display_name\": \"Maruti Dzire AC\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/fares/vehicle-models/{{sedanModelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "fares", "vehicle-models", "{{sedanModelId}}"]
            },
            "description": "Updates passenger capacity or active state for Maruti Dzire."
          }
        }
      ]
    },
    {
      "name": "03. Admin — Global Commercial Settings",
      "item": [
        {
          "name": "3.1 List All Fare Settings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/fares/settings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "fares", "settings"]
            },
            "description": "Lists commercial settings keys: advance_percent (28), min_km_per_day (300), max_round_trip_days (5), night_start_hour (20), night_end_hour (6)."
          }
        },
        {
          "name": "3.2 Update Max Round-Trip Days (Requirement B)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/fares/settings/max_round_trip_days",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "fares", "settings", "max_round_trip_days"]
            },
            "description": "Updates max_round_trip_days to 5 calendar days with audit trail."
          }
        }
      ]
    },
    {
      "name": "04. Admin — Outstation Route Distance & Pricing",
      "item": [
        {
          "name": "4.1 Calculate Distance via LocationIQ",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin_name\": \"Agra, Uttar Pradesh\",\n  \"destination_name\": \"New Delhi, Delhi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/routes/calculate-distance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "routes", "calculate-distance"]
            },
            "description": "Queries LocationIQ over HTTPS, returning distance rounded to 1 decimal km and integer duration in minutes without auto-saving."
          }
        },
        {
          "name": "4.2 Set Flat Prices for Vehicles on Agra->Delhi Corridor",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicles\": [\n    {\n      \"vehicle_model_id\": \"10000000-0000-0000-0002-000000000001\",\n      \"one_way_amount\": 2500,\n      \"round_trip_enabled\": true,\n      \"inclusions\": [\"Toll Tax\", \"State Permit\"],\n      \"exclusions\": [\"Parking Charges\"]\n    },\n    {\n      \"vehicle_model_id\": \"10000000-0000-0000-0002-000000000004\",\n      \"one_way_amount\": 4500,\n      \"round_trip_enabled\": true,\n      \"inclusions\": [\"Toll Tax\", \"State Permit\", \"Driver Allowance\"],\n      \"exclusions\": [\"Parking Charges\"]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/routes/{{routeId}}/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "routes", "{{routeId}}", "vehicles"]
            },
            "description": "Atomically sets flat vehicle pricing and inclusions/exclusions on the Agra->Delhi corridor."
          }
        }
      ]
    },
    {
      "name": "05. Admin — Round-Trip ₹/KM Rules",
      "item": [
        {
          "name": "5.1 Set Innova Crysta Round-Trip ₹/KM Rate (₹18/km)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 18,\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/fares/rules/{{innovaFareRuleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "fares", "rules", "{{innovaFareRuleId}}"]
            },
            "description": "Updates global outstation round-trip ₹/km rate for Innova Crysta."
          }
        }
      ]
    },
    {
      "name": "06. Admin — Extra Charges & Policies",
      "item": [
        {
          "name": "6.1 Create Line-Item Extra Charge (e.g. State Permit UP->Delhi)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"outstation\",\n  \"label\": \"Delhi State Entry Permit\",\n  \"amount\": 150,\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/fares/extra-charges",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "fares", "extra-charges"]
            },
            "description": "Creates a deterministic numeric extra charge line item added into outstation quotes."
          }
        },
        {
          "name": "6.2 Create Policy Disclaimer Note (amount is null)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"outstation\",\n  \"label\": \"Luggage carrier policy: Extra rooftop luggage fee may apply for bulky bags.\",\n  \"amount\": null,\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/fares/extra-charges",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "fares", "extra-charges"]
            },
            "description": "Creates an informational policy note returned to the customer without adding to the fare total."
          }
        }
      ]
    },
    {
      "name": "07. Customer — Public Catalog",
      "item": [
        {
          "name": "7.1 Fetch Published Catalog",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog"]
            },
            "description": "Returns all active published products across the 4 categories with real starting_price_inr."
          }
        },
        {
          "name": "7.2 Fetch Product Detail (Outstation: Agra to Delhi)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/outstation/agra-to-delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "outstation", "agra-to-delhi"]
            },
            "description": "Returns detail view of Agra->Delhi with route distance, vehicle starting rates, and inclusions/exclusions."
          }
        }
      ]
    },
    {
      "name": "08. Customer — Reactive Quotes & Options",
      "item": [
        {
          "name": "8.1 Options Request — One-Way (Agra to Delhi)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"outstation\",\n  \"route_id\": \"{{routeId}}\",\n  \"trip_type\": \"one_way\",\n  \"passenger_count\": 2,\n  \"pickup_at\": \"2026-10-15T09:00:00+05:30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes/options",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes", "options"]
            },
            "description": "Returns available cars grouped by the 4 vehicle groups with live line-item breakdowns."
          }
        },
        {
          "name": "8.2 Options Request — Round-Trip (3 Days IST Calendar)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"outstation\",\n  \"route_id\": \"{{routeId}}\",\n  \"trip_type\": \"round_trip\",\n  \"passenger_count\": 5,\n  \"pickup_at\": \"2026-10-15T09:00:00+05:30\",\n  \"return_at\": \"2026-10-17T20:00:00+05:30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes/options",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes", "options"]
            },
            "description": "Calculates (17 - 15 + 1) = 3 calendar days. Multiplies 3 * 300km = 900km minimum billing + 3 days driver allowance."
          }
        },
        {
          "name": "8.3 Authoritative Quote — Innova Crysta One-Way",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"outstation\",\n  \"route_id\": \"{{routeId}}\",\n  \"vehicle_model_id\": \"{{innovaModelId}}\",\n  \"trip_type\": \"one_way\",\n  \"passenger_count\": 5,\n  \"pickup_at\": \"2026-10-15T09:00:00+05:30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes"]
            },
            "description": "Generates binding server quote with 28% advance_amount and 72% balance_amount."
          }
        }
      ]
    },
    {
      "name": "09. Customer — Bookings & Concurrency Shield",
      "item": [
        {
          "name": "9.1 Create Real Booking (Valid Quoted Total)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.booking && res.booking.id) {",
                  "  pm.collectionVariables.set('lastBookingId', res.booking.id);",
                  "  pm.environment.set('lastBookingId', res.booking.id);",
                  "  console.log('Stored bookingId:', res.booking.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quote\": {\n    \"category\": \"outstation\",\n    \"route_id\": \"{{routeId}}\",\n    \"vehicle_model_id\": \"{{sedanModelId}}\",\n    \"trip_type\": \"one_way\",\n    \"passenger_count\": 2,\n    \"pickup_at\": \"2026-10-15T09:00:00+05:30\"\n  },\n  \"quoted_total\": 2650,\n  \"customer_name\": \"Tarun Sisodia\",\n  \"customer_phone\": \"+919876543210\",\n  \"customer_email\": \"tarun@example.com\",\n  \"pickup_address\": \"Tajganj, Agra\",\n  \"drop_address\": \"Connaught Place, New Delhi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings"]
            },
            "description": "Creates booking. Server recomputes fare: if quoted_total matches (2500 base + 150 state permit = 2650), returns 201 Created and ticket_id."
          }
        },
        {
          "name": "9.2 Tampered Price Test (Expect HTTP 409 PRICE_CHANGED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quote\": {\n    \"category\": \"outstation\",\n    \"route_id\": \"{{routeId}}\",\n    \"vehicle_model_id\": \"{{sedanModelId}}\",\n    \"trip_type\": \"one_way\",\n    \"passenger_count\": 2,\n    \"pickup_at\": \"2026-10-15T09:00:00+05:30\"\n  },\n  \"quoted_total\": 1200,\n  \"customer_name\": \"Malicious Request\",\n  \"customer_phone\": \"+919876543210\",\n  \"customer_email\": \"attacker@example.com\",\n  \"pickup_address\": \"Agra\",\n  \"drop_address\": \"Delhi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings"]
            },
            "description": "Tests Concurrency Shield: Client sends tampered total (₹1200 instead of server ₹2650). Server rejects with 409 PRICE_CHANGED and returns fresh_quote."
          }
        },
        {
          "name": "9.3 Fetch Booking Voucher by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{lastBookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "{{lastBookingId}}"]
            },
            "description": "Returns verified booking entity and voucher details."
          }
        },
        {
          "name": "9.4 Create Razorpay Advance Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{lastBookingId}}/payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "{{lastBookingId}}", "payment"]
            },
            "description": "Creates idempotent Razorpay order for advance_amount in paise (e.g. ₹742 * 100 = 74200 paise)."
          }
        }
      ]
    },
    {
      "name": "10. Admin — Audit Trail & Outbox Monitor",
      "item": [
        {
          "name": "10.1 Inspect Admin Audit Log Diffs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/audit-logs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "audit-logs"]
            },
            "description": "Inspects before-and-after JSON snapshots recorded for all rate, extra charge, and vehicle edits."
          }
        },
        {
          "name": "10.2 Inspect Publishing Outbox Events",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/publishing/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "publishing", "events"]
            },
            "description": "Inspects catalog publishing outbox events that trigger site rebuilds."
          }
        }
      ]
    }
  ]
}
