      "name": "01. Server Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Verifies that the backend Fastify server is running and healthy."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Health response indicates healthy or ready\", function () {",
              "    const json = pm.response.json();",
              "    const status = (json.data && json.data.status) || json.status;",
              "    pm.expect(status).to.be.oneOf([\"healthy\", \"ready\", \"ok\"]);",
              "});"
            ]
          }
        }
      ]
