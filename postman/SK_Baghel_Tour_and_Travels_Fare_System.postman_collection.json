            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"outstation\",\n  \"route_id\": \"{{routeId}}\",\n  \"trip_type\": \"one_way\",\n  \"passenger_count\": 2,\n  \"pickup_at\": \"2026-10-15T09:00:00+05:30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes/options",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "quotes",
