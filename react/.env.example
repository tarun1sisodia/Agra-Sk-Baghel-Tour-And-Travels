# Customer React app — safe-to-expose browser configuration only.
# Use the matching STAGING Supabase project when testing against staging.
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
# Prefer the Supabase publishable key. The previous anon key is also supported.
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
# VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
VITE_API_BASE_URL=http://localhost:4000

# Public origin for canonical, Open Graph, sitemap, and robots URLs.
VITE_SITE_URL=https://agraskbagheltourandtravels.com
# Use production for release builds; preview only with an explicit HTTPS preview origin.
VITE_SITE_MODE=development
# Keep Hindi indexing disabled until advertised Hindi routes have complete content and artifacts.
VITE_HINDI_INDEXING_ENABLED=false

# Never put Supabase service-role keys, Razorpay secrets, DB URLs, or AWS secret keys here.
