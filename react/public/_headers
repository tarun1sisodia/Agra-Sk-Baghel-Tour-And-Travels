# Agra SK Baghel Tour & Travels — Customer site security & cache headers

# Security headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://*.googletagmanager.com https://static.cloudflareinsights.com https://scripts.clarity.ms https://*.clarity.ms https://checkout.razorpay.com https://apis.google.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com https://www.googletagmanager.com https://*.googletagmanager.com https://*.google-analytics.com https://*.clarity.ms https://*.bing.com https://*.g.doubleclick.net https://*.google.com https://*.doubleclick.net https://api.agraskbagheltourandtravels.com; connect-src 'self' https://api.agraskbagheltourandtravels.com https://*.supabase.co https://*.clarity.ms https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.google.com https://stats.g.doubleclick.net https://api.razorpay.com https://*.razorpay.com https://accounts.google.com; frame-src 'self' https://checkout.razorpay.com https://api.razorpay.com https://accounts.google.com https://*.googletagmanager.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self';
  Alt-Svc: h3=":443"; ma=86400
  Cache-Control: no-cache, must-revalidate

# Root homepage with RFC 8288 & RFC 9727 agent discovery Link headers
/
  Cache-Control: no-cache, must-revalidate
  Link: </.well-known/api-catalog>; rel="api-catalog", </openapi.json>; rel="service-desc", </llms.txt>; rel="service-doc", </.well-known/agent-card.json>; rel="describedby"

# Agent discovery endpoints & well-known manifests
/.well-known/*
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/openapi.json
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8

/auth.md
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
  Content-Type: text/markdown; charset=utf-8

# Public key and text verification files
/*.txt
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

# Vite emits content-hashed filenames — safe to cache for 1 year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Timing-Allow-Origin: *

# Self-hosted web fonts — immutable static assets
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Timing-Allow-Origin: *

# Static public images
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Timing-Allow-Origin: *

# Icons & Favicon
/favicon.ico
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# HTML must always revalidate so visitors pick up re-deploys instantly.
/*.html
  Cache-Control: no-cache, must-revalidate

# The service worker script itself must always revalidate so updates propagate.
/sw.js
  Cache-Control: no-cache, must-revalidate

# Sitemap and robots.txt — short TTL so search engines get fresh copies.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# IndexNow verification key
/a778e32d79ca4971a3bb647d9c0c71a2.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# Do not preload a fixed image here. The current homepage chooses its first
# image at runtime, so a fixed Early Hints preload would waste bandwidth.
