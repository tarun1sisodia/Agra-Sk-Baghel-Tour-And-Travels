NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
# Public customer origin used when backend sends tokenized review invitations.
# Production: https://agraskbagheltourandtravels.com
CUSTOMER_SITE_URL=https://agraskbagheltourandtravels.com
LOG_LEVEL=info
FARE_RULES_VERSION=2026-09-13

# Comma-separated extra CORS origins (local Vite is always allowed).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4174,http://localhost:4175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000,https://agraskbagheltourandtravels.com,https://skbagheltravels-admin.coccoder999.workers.dev,https://agraskbagheltourandtravels.com,https://admin.agraskbagheltourandtravels.com

# Set true only in local/test. Never enable in production.
ALLOW_TEST_AUTH=false
# Staged cutover: require verified customer auth for legacy direct draft creation.
CUSTOMER_AUTH_REQUIRED_FOR_NEW_BOOKINGS=false

# PostgreSQL / Supabase. From Render use the Supabase SESSION POOLER string
# (Project Settings -> Database -> Connection string -> Session pooler, port 5432)
# and append ?sslmode=require — the direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Supabase Storage bucket that receives catalog image uploads from the admin
# CMS. Create this bucket in the Supabase dashboard first.
CATALOG_MEDIA_BUCKET=documents

# S3 protocol connection (preferred upload path) — Supabase Dashboard ->
# Storage -> S3 Connection gives you the endpoint + region below. Generate an
# access key pair there too, but NEVER commit real keys to this file — set
# them directly on the server (Render dashboard env vars / local .env, which
# is git-ignored).
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional MongoDB (cache / raw webhooks only — never the ledger)
MONGODB_URI=

# Razorpay (India). Test keys only until webhook drills pass.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PayPal sandbox — webhook secret only required when the provider is enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# International card processor (adapter-shaped; HMAC webhook)
# CARD_WEBHOOK_SECRET only required when CARD_PROVIDER_SECRET is set.
CARD_PROVIDER_SECRET=
CARD_WEBHOOK_SECRET=
CARD_CHECKOUT_BASE_URL=https://checkout.example-cards.test

# LocationIQ — server-held only
LOCATIONIQ_TOKEN=

# Notifications
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_PAYMENT=skb_payment_confirmed
RESEND_API_KEY=
EMAIL_FROM=bookings@agraskbagheltourandtravels.com

# Customer-site publishing
PAGES_DEPLOY_HOOK_URL=
CLOUDFLARE_DEPLOY_HOOK_URL=
DEPLOY_CALLBACK_SECRET=

# Sandbox FX table used only when creating non-INR checkouts from an INR advance.
FX_USD_PER_INR=0.012
FX_EUR_PER_INR=0.011
FX_GBP_PER_INR=0.0095
