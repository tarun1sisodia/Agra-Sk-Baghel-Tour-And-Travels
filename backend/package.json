{
  "name": "@sk-baghel/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SK Baghel Tour & Travels production API — fares, bookings, payments, dispatch, catalog.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests --exclude tests/integration/db-connection.test.ts --exclude tests/integration/db-indexes.test.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test:db": "tsx scripts/test-db.ts",
    "sync-contracts": "tsx ../contracts/scripts/sync-contracts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@pdfme/common": "^6.2.6",
    "@pdfme/generator": "^6.2.6",
    "@pdfme/schemas": "^6.2.6",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7",
    "jose": "^6.1.0",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "pino": "^9.9.5",
    "pino-pretty": "^13.2.0",
    "razorpay": "^2.9.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.15.5",
    "eslint": "^9.35.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  }
}
