# Customer and admin frontend API origin.
# Use the production API hostname in Cloudflare Pages variables.
VITE_API_BASE_URL=https://api.agraskbagheltourandtravels.com

# Admin panel (Cloudflare Pages project skbagheltravels-admin) — Supabase Auth.
# These are PUBLIC browser values (anon key only — never the service_role key).
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>

# React migration gate. Keep false until the React platform is approved for cutover.
VITE_REACT_MIGRATION_ENABLED=false

# Optional uptime-check overrides. Defaults target the provider-hosted live URLs.
# Set this to custom domains if you want DNS/domain monitoring as part of uptime checks.
# HEALTHCHECK_URLS=https://api.agraskbagheltourandtravels.com/health,https://agraskbagheltourandtravels.com/,https://admin.agraskbagheltourandtravels.com/
# HEALTHCHECK_TIMEOUT_MS=10000
# HEALTHCHECK_ATTEMPTS=2

# Optional deployment-injected LocationIQ public browser token.
# Never commit a real token to this file or source control.
# VITE_LOCATIONIQ_ACCESS_TOKEN=
